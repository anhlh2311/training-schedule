VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_ADMIN_EMAIL=admin@example.com
VITE_FIREBASE_VAPID_PUBLIC_KEY=your-vapid-public-key
VITE_ONESIGNAL_APP_ID=
VITE_APP_URL=https://your-app.vercel.app
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Training Schedule <noreply@yourdomain.com>

# OneSignal (optional): when set, trainer notifications use OneSignal instead of FCM
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Include debug info (payloadSummary, formatted message, OneSignal request/response) in /api/notify responses. Set to "true" or "1" for staging/debugging.
NOTIFY_DEBUG=
